# OAuth 2.0 Web application client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Required only to create the first admin account through /admin/register.
ADMIN_REGISTRATION_KEY=replace-with-a-long-random-secret

# Razorpay Standard Checkout (use Test Mode keys first; keep the secret server-side)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
